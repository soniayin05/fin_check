# Copy to .env only on a fresh clone. Never commit the real key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Required for prepare-data --include-sec. SEC asks automated tools to declare a contact:
# an app or person name followed by an email, e.g. FinCheck Jane Doe jane@example.edu
SEC_USER_AGENT=
# Retrieval. FINCHECK_RETRIEVER: keyword, tfidf, bm25, embedding or hybrid (embedding/hybrid need GEMINI_API_KEY).
FINCHECK_RETRIEVER=keyword
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_EMBED_DIM=768
